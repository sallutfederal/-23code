{
  "name": "ai-assistant",
  "version": "1.0.0",
  "description": "AI Chat Desktop App",
  "main": "backend/main.js",
  "scripts": {
    "start": "npm run build:frontend && electron .",
    "dev": "concurrently \"cd frontend && npm run dev\" \"node backend/dev-server.js\" \"sleep 2 && electron . --dev\"",
    "build:frontend": "cd frontend && npm run build",
    "build:win": "npm run build:frontend && electron-builder --win",
    "build:mac": "npm run build:frontend && electron-builder --mac",
    "build:linux": "npm run build:frontend && electron-builder --linux"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.6",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "ignore": "^5.3.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.ai-assistant.app",
    "productName": "AI Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "backend/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "backend/icon.ico"
    },
    "linux": {
      "icon": "backend/icon.ico"
    },
    "win": {
      "target": "nsis",
      "icon": "backend/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
